# Copy this file to .env and fill in your key. Never commit .env.

# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Check the current model name on DeepSeek's "Models & Pricing" page.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional extra request fields as JSON, e.g. to switch thinking mode off
# (use the exact field name from DeepSeek's "Thinking Mode" docs).
DEEPSEEK_EXTRA_BODY=

# Optional: fix "today" (YYYY-MM-DD) when testing date handling. Leave empty normally.
FROZEN_DATE=

MAX_QUESTIONS=5
